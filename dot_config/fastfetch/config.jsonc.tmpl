{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
{{- if eq .chezmoi.hostname "LinuxV6" }}
    // main-pc: own ASCII art
    "source": "~/.config/fastfetch/my_art.txt",
    "color": {
      "1": "cyan",
      "2": "magenta",
    },
{{- else }}
    // every other machine: the logo of its own system (macOS, Ubuntu, Debian, …)
    "type": "auto",
{{- end }}
  },
  "display": {
    "separator": " ➜  ",
    "key": {
      "width": 30,
    },
  },
  "modules": [
    "title",
    "separator",
    "break",

    // ────────────────────── Software System ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌──────────────────────System────────────────────────┐",
    },
    { "type": "os", "key": "│ {#cyan}{{- if eq .chezmoi.os "darwin" }}{{- else if eq .chezmoi.osRelease.id "ubuntu" }}{{- else if eq .chezmoi.osRelease.id "debian" }}{{- else if eq .chezmoi.osRelease.id "fedora" }}{{- else }}{{- end }} OS" },
    { "type": "kernel", "key": "│ ├⚙️ Kernel" },
    { "type": "uptime", "key": "│ ├󱎫 Uptime" },
    {
      "type": "packages",
      "key": "│ └󰏖 Packages",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

    // ────────────────────── Containers ──────────────────────
