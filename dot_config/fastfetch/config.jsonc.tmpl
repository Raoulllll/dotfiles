    // ────────────────────── Media Status ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌───────────────────────Media────────────────────────┐",
    },
    {
      "type": "media",
      "key": "│ {#green}󰝚 Now Playing",
      "format": "{1} - {3} ({5})",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

    // ────────────────────── OS Lifespan ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌─────────────────────Statistics─────────────────────┐",
    },
    {
      "type": "disk",
      "key": "│ {#cyan}󰔚 OS Age",
      "folders": "/",
      "format": "{days} days",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

    {
      "type": "colors",
      "key": " Palette",
      "symbol": "circle",
    },
  ],
