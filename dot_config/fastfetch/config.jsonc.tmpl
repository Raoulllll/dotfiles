{{- $server := has .chezmoi.hostname (list "ubuntu" "pie" "immich-pi") -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
{{- if eq .chezmoi.hostname "LinuxV6" }}
    // main-pc: own ASCII art
    "source": "~/.config/fastfetch/my_art.txt",
    "color": {
      "1": "cyan",
      "2": "magenta",
    },
{{- else }}
    // every other machine: the logo of its own system (macOS, Ubuntu, Debian, …)
    "type": "auto",
{{- end }}
  },
  "display": {
    "separator": " ➜  ",
    "key": {
      "width": 30,
    },
  },
  "modules": [
    "title",
    "separator",
    "break",

    // ────────────────────── Software System ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌──────────────────────System────────────────────────┐",
    },
    { "type": "command", "key": "│ {#cyan}{{- if eq .chezmoi.os "darwin" }}{{- else if eq .chezmoi.osRelease.id "ubuntu" }}{{- else if eq .chezmoi.osRelease.id "debian" }}{{- else if eq .chezmoi.osRelease.id "fedora" }}{{- else }}{{- end }} OS", "text": "if [ -r /etc/os-release ]; then . /etc/os-release; echo \"$NAME $VERSION_ID\" | sed -E 's# (GNU/)?Linux##'; else echo \"$(sw_vers -productName) $(sw_vers -productVersion)\"; fi" },  // only name + release, e.g. Fedora 44
    { "type": "command", "key": "│ ├⚙️ Kernel", "text": "uname -r | sed -E 's/[-+].*//'" },  // only the version, e.g. 7.3.1
    { "type": "uptime", "key": "│ ├󱎫 Uptime" },
    {
      "type": "packages",
      "key": "│ └󰏖 Packages",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

    // ────────────────────── Containers ──────────────────────
    //{
    //  "type": "custom",
    //  "format": "\u001b[94m┌────────────────────Containers──────────────────────┐",
    //},
    //
    //{
    //  "type": "command",
    //  "key": "│ {#magenta}󰡨 Distrobox",
    //  "text": "wc -l < $HOME/.cache/distrobox-pkg-counts 2>/dev/null || echo '0'",
    //},
    //{
    //  "type": "command",
    //  "key": "│ ├── alpine-box (apk)",
    //  "text": "grep 'alpine-box' $HOME/.cache/distrobox-pkg-counts 2>/dev/null | awk -F': ' '{print $2}'",
    //},
    //{
    //  "type": "command",
    //  "key": "│ ├── davincibox (rpm)",
    //  "text": "grep 'davincibox' $HOME/.cache/distrobox-pkg-counts 2>/dev/null | awk -F': ' '{print $2}'",
    //},
    //{
    //  "type": "command",
    //  "key": "│ ├── Ubuntu-24.04 (dpkg)",
    //  "text": "grep 'Ubuntu-24.04' $HOME/.cache/distrobox-pkg-counts 2>/dev/null | awk -F': ' '{print $2}'",
    //},
    //{
    //  "type": "command",
    //  "key": "│ ├── arch-sandbox (pacman)",
    //  "text": "grep 'arch-sandbox' $HOME/.cache/distrobox-pkg-counts 2>/dev/null | awk -F': ' '{print $2}'",
    //},
    //{
    //  "type": "command",
    //  "key": "│ └── debian-sid (dpkg)",
    //  "text": "grep 'debian-sid' $HOME/.cache/distrobox-pkg-counts 2>/dev/null | awk -F': ' '{print $2}'",
    //},
    //{
    //  "type": "custom",
    //  "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    //},
    //"break",

    // ────────────────────── Environment ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌───────────────────Environment──────────────────────┐",
    },
    { "type": "shell", "key": "│ {#yellow} Shell" },
{{- if not $server }}
    { "type": "de", "key": "│ ├ DE/WM" },
    { "type": "terminal", "key": "│ └ Terminal" },
{{- end }}
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

    // ────────────────────── Hardware Specs ──────────────────────
    //    {
    //    "type": "custom",
    //      "format": "\u001b[94m┌──────────────────────Hardware──────────────────────┐"
    //    },
    //    { "type": "cpu", "key": "│ {#blue} CPU" },
    //    { "type": "gpu", "key": "│ ├󰢮 GPU" },
    //    { "type": "memory", "key": "│ ├ Memory" },
    //    { "type": "physicalmemory", "key": "│ ├󰓅 RAM Specs" },
    //    { "type": "disk", "key": "│ └󰋊 Storage" },
    //    {
    //      "type": "custom",
    //      "format": "\u001b[94m└────────────────────────────────────────────────────┘"
    //    },
    //    "break",

{{- if $server }}
    {
      "type": "custom",
      "format": "\u001b[94m┌───────────────────────Server───────────────────────┐",
    },
    { "type": "cpu", "key": "│ {#cyan} CPU" },
    { "type": "memory", "key": "│ ├ Memory" },
    { "type": "disk", "key": "│ ├󰋊 Disk", "folders": "/" },
    { "type": "localip", "key": "│ └󰩟 LAN IP", "showIpv6": false },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

{{- else }}
    // ────────────────────── Media Status ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌───────────────────────Media────────────────────────┐",
    },
    {
      "type": "media",
      "key": "│ {#green}󰝚 Now Playing",
      "format": "{1} - {3} ({5})",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

{{- end }}
    // ────────────────────── OS Lifespan ──────────────────────
    {
      "type": "custom",
      "format": "\u001b[94m┌─────────────────────Statistics─────────────────────┐",
    },
    {
      "type": "disk",
      "key": "│ {#cyan}󰔚 OS Age",
      "folders": "/",
      "format": "{days} days",
    },
    {
      "type": "custom",
      "format": "\u001b[94m└────────────────────────────────────────────────────┘",
    },
    "break",

{{- if not $server }}
    {
      "type": "colors",
      "key": " Palette",
      "symbol": "circle",
    },
{{- end }}
  ],
}
