# chezmoi ignore rules: which file goes on which device. Paths are target paths in $HOME.
# Devices: main-pc (hostname LinuxV6, Fedora KDE), laptop (Fedora KDE), Mac Studio (macOS, zsh),
# servers ubuntu, pie, immich-pi (zsh, starship, fastfetch, micro, btop, git only).
{{- $server := has .chezmoi.hostname (list "ubuntu" "pie" "immich-pi") }}

# --- Never applied anywhere: repo files and generated lists ---
archive
README.md
bootstrap.sh
fedorabootstrap.sh
hosts
pkglist.txt
flatpaks.txt
Brewfile
distrobox.ini
ollama-models.txt

# --- Never tracked (also do not add them): logs, backups, secrets ---
**/logs
**/*.log
**/*.bak

{{ if not (or (eq .chezmoi.os "darwin") $server) }}
# --- zsh: Mac and servers only (main-pc and laptop use fish) ---
.zshrc
{{ end }}

{{ if or (ne .chezmoi.os "linux") $server }}
# --- Linux desktops only (Fedora, KDE, Hyprland, systemd, PipeWire): not on the Mac, not on the servers ---
.config/Kvantum
.config/autostart
.config/brave-flags.conf
.config/caelestia
.config/dolphinrc
.config/environment.d
.config/fontconfig
.config/gtk-3.0
.config/gtk-4.0
.config/hypr
.config/kcminputrc
.config/kdeglobals
.config/kglobalshortcutsrc
.config/klipperrc
.config/konsolerc
.config/krunnerrc
.config/ksmserverrc
.config/kwinoutputconfig.json
.config/kwinrc
.config/kwinrulesrc
.config/libinput-gestures.conf
.config/mimeapps.list
.config/pipewire
.config/plasma-localerc
.config/plasma-org.kde.plasma.desktop-appletsrc
.config/plasmanotifyrc
.config/plasmashellrc
.config/powerdevilrc
.config/solaar
.config/spectaclerc
.config/systemd
.config/user-dirs.dirs
.config/wireplumber
.local/bin/*
{{- if not $server }}
!.local/bin/cz-sync.sh
!.local/bin/fetch-layout
{{- end }}
{{ end }}

{{ if ne .chezmoi.hostname "LinuxV6" }}
# --- main-pc only: its monitors, GPU, RGB, autostart apps ---
.config/kwinoutputconfig.json
.config/lact
.config/OpenRGB
.config/autostart
.local/bin/steam-gamescope-wrapper
{{ end }}

{{ if $server }}
# --- servers: no desktop app configs (they get .zshrc, starship, fastfetch, micro, btop, .gitconfig) ---
.config/fish
.config/kitty
.config/zed
.config/topgrade.toml
.config/htop
.config/OpenRGB
.config/lact
{{ end }}
